# These are set as Vercel project environment variables (not read from a local
# file in production). Use `vercel env add <NAME> production` to set them, or
# the Vercel dashboard → Project → Settings → Environment Variables.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Numeric Telegram IDs allowed to use the bot (comma-separated). Get an ID by
# messaging @userinfobot with /start.
ALLOWED_TELEGRAM_ID=111111111,222222222

# The deployed site's stable production URL (used to build per-patient card
# links sent by the bot).
BASE_URL=https://your-project.vercel.app

# Provisioned automatically when you run `vercel install neon` and
# `vercel blob create-store` — no need to set these by hand:
#   POSTGRES_URL / DATABASE_URL      (Neon Postgres connection string)
#   BLOB_READ_WRITE_TOKEN            (Vercel Blob access token)
